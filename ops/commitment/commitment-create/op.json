{
  "op_id": "commitment-create",
  "kind": "native",
  "version": "1.0.0",
  "summary": "Create one commitment, reminder, task, or loop-closure obligation.",
  "enabled": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "description": {"type": "string"},
      "provenance_reference": {"anyOf": [{"type": "string"}, {"type": "null"}]},
      "ingestion_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
      "source": {"anyOf": [{"type": "string"}, {"type": "null"}]},
      "due_by": {"anyOf": [{"type": "date-time"}, {"type": "object", "title": "date"}, {"type": "null"}]},
      "due_timezone": {"anyOf": [{"type": "string"}, {"type": "null"}]},
      "importance": {"type": "integer"},
      "effort_provided": {"type": "integer"},
      "effort_inferred": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
      "confidence": {"anyOf": [{"type": "number"}, {"type": "null"}]},
      "requested_by": {"type": "string"}
    },
    "required": ["description"],
    "additionalProperties": false
  },
  "output_schema": {"type": "object"},
  "call_target": "service_commitment.create_commitment",
  "slash_command": {
    "name": "todo",
    "description": "create a commitment, reminder, or task",
    "aliases": ["remember-task"]
  },
  "effect": "write",
  "approval": "always"
}
