{
  "op_id": "commitment-update",
  "kind": "native",
  "version": "1.0.0",
  "summary": "Update one commitment without changing its lifecycle state.",
  "enabled": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "commitment_id": {"type": "string"},
      "description": {"anyOf": [{"type": "string"}, {"type": "null"}]},
      "provenance_reference": {"anyOf": [{"type": "string"}, {"type": "null"}]},
      "ingestion_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
      "source": {"anyOf": [{"type": "string"}, {"type": "null"}]},
      "due_by": {"anyOf": [{"type": "date-time"}, {"type": "object", "title": "date"}, {"type": "null"}]},
      "due_timezone": {"anyOf": [{"type": "string"}, {"type": "null"}]},
      "importance": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
      "effort_provided": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
      "effort_inferred": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
      "reviewed_at": {"anyOf": [{"type": "date-time"}, {"type": "null"}]}
    },
    "required": ["commitment_id"],
    "additionalProperties": false
  },
  "output_schema": {"type": "object"},
  "call_target": "service_commitment.update_commitment",
  "slash_command": {
    "name": "commitment-update",
    "description": "update one commitment without changing state",
    "aliases": []
  },
  "effect": "write",
  "approval": "always"
}
