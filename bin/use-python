#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: bin/use-python <python-version>" >&2
  exit 1
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
VERSION="$1"

cd "${REPO_ROOT}"

uv python install "${VERSION}"
echo "${VERSION}" > .python-version
rm -rf .venv
make deps

echo
echo "Python updated for ${REPO_ROOT}"
echo "  version: $(.venv/bin/python --version)"
echo "  .python-version: $(cat .python-version)"
