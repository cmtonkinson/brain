logging:
  level: INFO
  file_capture_enabled: false
  file_capture_level: VERBOSE
  file_capture_directory: logs
  json_output: true
  process_name: core
  environment: dev

observability:
  public_api:
    otel:
      meter_name: brain.public_api
      tracer_name: brain.public_api
      metric_public_api_calls_total: brain_public_api_calls_total
      metric_public_api_duration_ms: brain_public_api_duration_ms
      metric_public_api_errors_total: brain_public_api_errors_total
      metric_instrumentation_failures_total: brain_public_api_instrumentation_failures_total
      metric_qdrant_ops_total: brain_qdrant_ops_total
      metric_qdrant_op_duration_ms: brain_qdrant_op_duration_ms

profile:
  operator:
    signal_contact_e164: "+12222222222"
  approval_responses:
    approve_reaction_emojis:
      - 👍
      - ✅
    reject_reaction_emojis:
      - 👎
      - ❌
    approve_text_responses:
      - "approve"
      - "approved"
      - "yes"
    reject_text_responses:
      - "deny"
      - "denied"
      - "no"
  default_dial_code: "+1"
  operator_name: Operator
  brain_name: Brain
  brain_verbosity: normal

boot:
  run_migrations_on_startup: true
  readiness_poll_interval_seconds: 0.25
  readiness_timeout_seconds: 30.0
  boot_retry_attempts: 3
  boot_retry_delay_seconds: 0.5
  boot_timeout_seconds: 30.0

http:
  host: 0.0.0.0
  port: 8898

health:
  max_timeout_seconds: 1.0

service:
  attention_router:
    default_channel: signal
    max_message_chars: 4000
    dedupe_window_seconds: 120
    rate_limit_window_seconds: 60
    rate_limit_max_per_window: 20
    batch_summary_max_items: 5
  capability_engine:
    discovery_root: capabilities
    default_max_autonomy: 0
    always_on_capability_ids: []
    capability_search_top_k: 10
  embedding_authority:
    max_list_limit: 500
  cache_authority:
    key_prefix: brain
    default_ttl_seconds: 300
    allow_non_expiring_keys: true
  memory_authority:
    min_turns_to_keep: 10
    max_turns_to_keep: 20
    focus_token_budget: 512
  object_authority:
    digest_algorithm: sha256
    digest_version: b1
    max_blob_size_bytes: 52428800
  policy_service:
    dedupe_window_seconds: 60
    approval_ttl_seconds: 900
    retention_max_rows: null
    retention_max_age_seconds: null
    auto_bind_threshold: 0.9
    clarify_threshold: 0.6
    base_policy:
      policy_id: default
      policy_version: "1"
      rules:
        "*":
          enabled: true
          autonomy_ceiling: null
          actors_allow: []
          actors_deny: []
          channels_allow: []
          channels_deny: []
          require_approval: null
    overlays: []
  vault_authority:
    max_list_limit: 500
    max_search_limit: 200
  language_model:
    document_embedding:
      provider: ollama
      model: mxbai-embed-large
    capability_embedding:
      provider: ollama
      model: mxbai-embed-large
    quick:
      provider: ollama
      model: gpt-oss:20b
    standard:
      provider: ollama
      model: gpt-oss:20b
    deep:
      provider: ollama
      model: gpt-oss:20b
  switchboard:
    queue_name: signal_inbound
    callback_register_max_retries: 8
    callback_register_retry_delay_seconds: 2.0
