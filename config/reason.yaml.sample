commitment:
  autonomous_creation_confidence_threshold: 0.9
  autonomous_transition_confidence_threshold: 0.9
  default_timezone: UTC
  review_batch_key: commitment-review
  follow_up_op_id: commitment-run-miss-detection
  dedupe_enabled: true
  dedupe_confidence_threshold: 0.8
  dedupe_summary_max_words: 50
  dedupe_scan_limit: 200
  extraction_enabled: true
  extraction_min_confidence: 0.4
  extraction_max_candidates: 10
  extraction_reasoning_level: quick

delegation:
  max_recursion_depth: 4
  sweeper_interval_seconds: 30.0

ingestion:
  anchor_folder: anchors
  max_payload_bytes: 104857600

job:
  default_max_attempts: 3
  default_backoff_strategy: exponential
  default_backoff_base_seconds: 60
  orphan_grace_period_hours: 24
  consecutive_failure_threshold: 3
  ignored_pause_age_days: 30
  stalled_execution_threshold_minutes: 60
  retry_batch_size: 100
  provider_poll_interval_seconds: 15.0

policy:
  dedupe_window_seconds: 60
  approval_ttl_seconds: 900
  retention_max_rows: null
  retention_max_age_seconds: null
  auto_bind_threshold: 0.9
  clarify_threshold: 0.6
  slash_authenticity_validity_seconds: 60
  base_policy:
    policy_id: default
    policy_version: "1"
    rules:
      "*":
        enabled: true
        actors_allow: []
        actors_deny: []
        channels_allow: []
        channels_deny: []
        approval: null
  overlays: []
  actors: {}

recall:
  min_turns_to_keep: 10
  max_turns_to_keep: 20
  focus_token_budget: 512
  conversation_episode_idle_seconds: 3600
