logging:
  level: INFO
  json_output: true
  service: brain
  environment: dev

core:
  # Path to the Brain Core Unix socket. On the host this is typically under
  # ~/.config/brain/generated/. Inside a container it is /app/config/generated/brain.sock.
  socket_path: ~/.config/brain/generated/brain.sock
  timeout_seconds: 30.0

cli:
  principal: operator
  source: cli

agent:
  principal: agent
  source: agent
  capability_discovery_deny_list:
    - attention-notify

beat:
  principal: operator
  source: beat

worker:
  principal: operator
  source: worker
