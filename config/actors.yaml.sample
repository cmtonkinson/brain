logging:
  level: INFO
  file_capture_enabled: false
  file_capture_level: VERBOSE
  file_capture_directory: logs
  json_output: true
  process_name: agent
  environment: dev

core:
  host: 127.0.0.1
  port: 8898
  timeout_seconds: 30.0

cli:
  principal: operator
  source: cli

agent:
  principal: operator
  source: agent
  capability_discovery_deny_list:
    - attention-notify
  tool_return_compress_threshold: 4000
  tool_return_max_chars: 8000
  tool_loop_tier2_hop_threshold: 3

beat:
  principal: operator
  source: beat

worker:
  principal: operator
  source: worker
