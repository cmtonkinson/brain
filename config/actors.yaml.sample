logging:
  level: INFO
  json_output: true
  service: brain
  environment: dev

core:
  host: 127.0.0.1
  port: 8898
  timeout_seconds: 30.0

cli:
  principal: operator
  source: cli

agent:
  principal: agent
  source: agent
  capability_discovery_deny_list:
    - attention-notify

beat:
  principal: operator
  source: beat

worker:
  principal: operator
  source: worker
