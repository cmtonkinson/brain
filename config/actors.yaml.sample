cli:
  principal: operator
  source: cli

assistant:
  principal: operator
  source: assistant
  session_start_mode: existing
  personality: default
  operator_profile: "Refer to me as 'boss'"
  system_prompt_append: ""
  op_discovery_deny_list:
    - relay-notify
  environment_context:
    - op_id: current-datetime
      input_payload: {}
  tool_return_compress_threshold: 4000
  tool_return_max_chars: 8000
  tool_loop_tier2_hop_threshold: 3

console:
  principal: operator
  source: console
  poll_timeout_seconds: 30.0
  poll_error_backoff_seconds: 1.0
  input_max_lines: 10
  editor: vim

worker:
  principal: operator
  source: worker
  channel: worker
  max_workers: 4
  poll_interval_seconds: 2.0

subagent:
  principal: subagent
  source: subagent
  max_workers: 1
  poll_interval_seconds: 2.0
  default_personality: subagent
  default_max_turns: 8
  default_budget_tokens: 200000
