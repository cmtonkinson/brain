# Docker Compose defaults for Signal adapter deployment.
SIGNAL_CLI_REST_API_IMAGE=bbernhard/signal-cli-rest-api:latest
SIGNAL_CLI_REST_API_MODE=json-rpc
SIGNAL_CLI_REST_API_JSON_RPC_IGNORE_ATTACHMENTS=true
SIGNAL_CLI_REST_API_JSON_RPC_IGNORE_STORIES=true
SIGNAL_CLI_REST_API_PORT=8080
SIGNAL_CLI_CONFIG_DIR=./data/signal-cli
