{
  "capability_id": "chunk-text",
  "kind": "native_op",
  "version": "1.0.0",
  "summary": "Split text into ordered chunks.",
  "enabled": true,
  "autonomy": 0,
  "requires_approval": false,
  "side_effects": [],
  "input_schema": {
    "text": "string | The text to chunk."
  },
  "output_schema": {
    "type": "array",
    "description": "Ordered chunks derived from the input text.",
    "items": {
      "type": "object",
      "properties": {
        "chunk_ordinal": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        },
        "reference_range": {
          "type": "string"
        }
      },
      "required": ["chunk_ordinal", "text", "reference_range"],
      "additionalProperties": false
    }
  },
  "call_target": "service_utility_service.chunk_text"
}
