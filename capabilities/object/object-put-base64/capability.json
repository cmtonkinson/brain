{
  "capability_id": "object-put-base64",
  "kind": "logic_skill",
  "version": "1.0.0",
  "summary": "Persist one base64-encoded blob and return the authoritative object record.",
  "enabled": true,
  "autonomy": 0,
  "requires_approval": false,
  "side_effects": ["writes_objects"],
  "required_capabilities": [],
  "input_schema": {
    "content_base64": "string | The base64-encoded blob content to persist.",
    "extension": "string | The file extension recorded for the object.",
    "content_type": "string | The MIME type recorded for the object.",
    "original_filename": "string | optional | Optional original filename metadata.",
    "source_uri": "string | optional | Optional source URI metadata."
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ref": {
        "type": "object",
        "properties": {
          "object_key": {
            "type": "string",
            "description": "The canonical object key."
          }
        },
        "required": ["object_key"]
      },
      "metadata": {
        "type": "object",
        "properties": {
          "digest_algorithm": {"type": "string"},
          "digest_version": {"type": "string"},
          "digest_hex": {"type": "string"},
          "extension": {"type": "string"},
          "content_type": {"type": "string"},
          "size_bytes": {"type": "integer"},
          "original_filename": {"type": "string"},
          "source_uri": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        },
        "required": [
          "digest_algorithm",
          "digest_version",
          "digest_hex",
          "extension",
          "content_type",
          "size_bytes",
          "original_filename",
          "source_uri",
          "created_at",
          "updated_at"
        ]
      }
    },
    "required": ["ref", "metadata"]
  }
}
